#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

# Preserve supplied model exports byte-for-byte on Windows and Linux.
/extras/itemsadder/contents/loveclans/models/siege/*.json -text
/extras/itemsadder/blockbench/*.bbmodel -text
